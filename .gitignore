# System files
.DS_Store

# Data snapshots — copied from pssda_pipeline's output, not owned/versioned
# here (one file exceeds GitHub's 100MB limit anyway). See README.md
# "Where the data comes from" for how to (re)populate this on a fresh clone.
data/processed/**/*.parquet
data/processed/dropdowns/*.json

# Home-page visit counter (web_app/visit_counter.py) — runtime state, not source
data/visits.txt

# Cube build output — regenerated by pipeline/, not hand-edited or versioned
data/profiles/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.env/
.venv/
